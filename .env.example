# Optional GitHub token. Public repositories can be analyzed without one, but authentication can improve API access limits.
GITHUB_TOKEN=

# Optional AI layer. Leave empty to use deterministic recommendations only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Repository analysis limits
MAX_FILES=80
MAX_FILE_BYTES=200000
GITHUB_API_VERSION=2026-03-10
